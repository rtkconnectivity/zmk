#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <zephyr/dt-bindings/gpio/realtek-bee-gpio.h>

&gpio {
    status = "okay";
};

&timer5 {
    status = "okay";
};

&timer6 {
    status = "okay";
};

