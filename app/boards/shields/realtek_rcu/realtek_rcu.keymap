#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define DEFAULT     0

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp K_POWER  &kp Q      &kp W     &kp E 
                &kp N3  &kp TAB    &kp CAPS  &kp F3
                &kp N1  &kp A      &kp S     &kp D 
                &kp N4  &kp ESC    &kp N5    &kp F4    
            >;
        };
    };
};

